{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "publicId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "course": { "type": "string" },
        "branch": { "type": "string" },
        "institution": { "type": "string" },
        "semesterYear": { "type": "string" },
        "careerGoal": { "type": "string" },
        "theme": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "fullName", "email"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Student goal item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "currentLevel": { "type": "string" },
        "targetLevel": { "type": "string" },
        "targetDate": { "type": "string" },
        "progressPercentage": { "type": "number" },
        "aiRoadmapGenerated": { "type": "boolean" },
        "aiPlanSummary": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "RoutineActivity": {
      "title": "RoutineActivity",
      "description": "Daily routine activity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "category": { "type": "string" },
        "completed": { "type": "boolean" },
        "skipped": { "type": "boolean" }
      },
      "required": ["id", "userId", "title"]
    },
    "TaskItem": {
      "title": "TaskItem",
      "description": "Student task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "goalId": { "type": "string" },
        "dueDate": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "SubjectItem": {
      "title": "SubjectItem",
      "description": "Course subject",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "examDate": { "type": "string" },
        "targetRevisionHours": { "type": "number" },
        "completedRevisionHours": { "type": "number" }
      },
      "required": ["id", "userId", "name"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Calendar event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "category": { "type": "string" },
        "isUrgent": { "type": "boolean" }
      },
      "required": ["id", "userId", "title"]
    },
    "SkillItem": {
      "title": "SkillItem",
      "description": "Skill item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "level": { "type": "string" },
        "certified": { "type": "boolean" },
        "certificationName": { "type": "string" },
        "lastAssessedDate": { "type": "string" }
      },
      "required": ["id", "userId", "name"]
    },
    "ProjectItem": {
      "title": "ProjectItem",
      "description": "Portfolio project item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "githubUrl": { "type": "string" },
        "progressPercentage": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "SavedJobTracker": {
      "title": "SavedJobTracker",
      "description": "Saved job application tracker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "jobId": { "type": "string" },
        "title": { "type": "string" },
        "companyName": { "type": "string" },
        "status": { "type": "string" },
        "appliedDate": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Student notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "UserProfile", "description": "Student user profile" },
    "/users/{uid}/goals/{goalId}": { "schema": "Goal", "description": "Student goals" },
    "/users/{uid}/routines/{routineId}": { "schema": "RoutineActivity", "description": "Daily routine items" },
    "/users/{uid}/tasks/{taskId}": { "schema": "TaskItem", "description": "Student tasks" },
    "/users/{uid}/studyPlans/{planId}": { "schema": "SubjectItem", "description": "Course study plans" },
    "/users/{uid}/calendarEvents/{eventId}": { "schema": "CalendarEvent", "description": "Calendar events" },
    "/users/{uid}/skills/{skillId}": { "schema": "SkillItem", "description": "Skill items" },
    "/users/{uid}/projects/{projectId}": { "schema": "ProjectItem", "description": "Projects" },
    "/users/{uid}/applications/{applicationId}": { "schema": "SavedJobTracker", "description": "Job applications" },
    "/users/{uid}/notifications/{notificationId}": { "schema": "NotificationItem", "description": "Notifications" }
  }
}
